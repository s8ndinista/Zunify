uniform float2 layer_size;
uniform float layer_scale;
uniform float power;
uniform float4 bands0;
uniform float4 bands1;
uniform float4 bands2;
uniform float4 bands3;
uniform float4 bands4;
uniform float4 bands5;
uniform float4 bands6;
uniform float4 bands7;

uniform float4 bands8;
uniform float4 bands9;
uniform float4 bands10;
uniform float4 bands11;
uniform float4 bands12;
uniform float4 bands13;
uniform float4 bands14;
uniform float4 bands15;

float4 band_group(int group) {
    if (group < 8) {
        if (group < 4) {
            if (group == 0) { return bands0; }
            if (group == 1) { return bands1; }
            if (group == 2) { return bands2; }
            return bands3;
        }
        if (group == 4) { return bands4; }
        if (group == 5) { return bands5; }
        if (group == 6) { return bands6; }
        return bands7;
    }
    if (group < 12) {
        if (group == 8) { return bands8; }
        if (group == 9) { return bands9; }
        if (group == 10) { return bands10; }
        return bands11;
    }
    if (group == 12) { return bands12; }
    if (group == 13) { return bands13; }
    if (group == 14) { return bands14; }
    return bands15;
}

float band(int index) {
    int group = index / 4;
    float4 values = band_group(group);
    int channel = index - group * 4;
    if (channel == 0) { return values.x; }
    if (channel == 1) { return values.y; }
    if (channel == 2) { return values.z; }
    return values.w;
}

half4 main(float2 coord) {
    float2 uv = coord / max(layer_size, float2(1.0));
    float distance = abs(uv.x - 0.5) * 2.0;
    float frequency = clamp(distance * 63.0, 0.0, 63.0);
    int lower = int(frequency);
    int upper = lower < 63 ? lower + 1 : 63;
    float amplitude = mix(band(lower), band(upper), smoothstep(0.0, 1.0, fract(frequency)));
    float center = 1.0 - smoothstep(0.0, 1.0, distance);
    float height = 1.0 - uv.y;
    float peak = smoothstep(0.0, 1.0, center);
    float crest = min(0.96, 0.060 + 0.49 * peak * peak * power + amplitude * (0.102 + 0.238 * center + 0.16 * peak * peak));
    float ribbon = 1.0 - smoothstep(0.0, crest, height);
    float haze = (1.0 - smoothstep(0.0, crest + 0.22, height)) * center;
    float alpha = power * (ribbon * (0.12 + center * 0.34 + amplitude * 0.21) + 0.24 * haze);
    float heat = (1.0 - smoothstep(0.0, crest, height)) * (0.18 + 0.68 * center);
    float3 tint = mix(float3(0.99, 0.10, 0.40), float3(1.0, 0.31, 0.12), heat);
    float opacity = alpha * mix(1.0, smoothstep(0.0, 0.15, uv.y), peak);
    return half4(tint * opacity, opacity);
}
